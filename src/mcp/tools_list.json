                },
                "session": {
                  "type": "string",
                  "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
                },
                "agent": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                }
              },
              "required": [
                "doc_id",
                "ts",
                "session",
                "role",
                "snippet"
              ]
            }
          },
          "total_sessions": {
            "type": "integer"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session": {
                  "type": "string",
                  "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
                },
                "agent": {
                  "type": "string"
                },
                "last_hit_ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "hit_count": {
                  "type": "integer"
                },
                "project": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "best_doc_id": {
                  "type": "integer",
