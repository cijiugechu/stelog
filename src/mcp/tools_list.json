    },
    {
      "name": "get_session_context",
      "description": "Fetch surrounding dialogue turns around a matched doc_id within the same session (collapses intermediate tool calls by default).",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "integer",
            "description": "Document id returned by search_history or get_decision_timeline."
          },
          "window": {
            "type": "integer",
            "description": "Number of dialogue turns before and after anchor (default 5)."
          },
          "max_bytes_per_item": {
            "type": "integer",
            "description": "Max bytes per turn (default 1200)."
          },
          "include_tools": {
            "type": "boolean",
            "description": "Include tool calls instead of collapsing them."
          }
        },
        "required": ["doc_id"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
          },
          "session_id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "anchor_doc_id": {
            "type": "integer",
            "description": "Stable document id (survives index rebuilds)."
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "integer",
                  "description": "Stable document id (survives index rebuilds)."
                },
                "ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "role": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "description": "Turn text, trimmed when trimmed=true (read it in full with get_document)."
                },
                "trimmed": {
                  "type": "boolean"
                },
                "tools_before": {
                  "type": "integer",
                  "description": "Tool records collapsed before this turn."
                },
                "anchor": {
                  "type": "boolean"
                }
              },
              "required": [
                "doc_id",
                "ts",
                "role",
                "text"
              ]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Notes and hints that also appear in the text result."
          }
        },
        "required": [
          "session",
          "session_id",
          "turns"
        ]
      }
    },
    {
      "name": "get_document",
      "description": "Read full or paginated content of one or more documents (pass doc_id, OR batch doc_ids:[id1,id2,...] up to 16 in a single call instead of scripting loops), or fetch raw JSONL via O(1) pread. Note: doc_ids include hidden tool_call records and are NOT contiguous dialogue turns — use get_session_context(doc_id) for neighboring dialogue instead of guessing adjacent doc_ids.",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "integer",
            "description": "Single document ID."
          },
          "doc_ids": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "Batch of up to 16 document IDs to read in one call (preferred over loops)."
          },
          "raw": {
            "type": "boolean",
            "description": "Read raw JSONL line from original transcript file."
          },
          "offset": {
            "type": "integer",
            "description": "Byte offset for pagination (single doc_id)."
          },
          "limit": {
            "type": "integer",
            "description": "Max bytes per document (default 7200 for single doc, auto-budgeted for batch)."
          },
          "tail": {
            "type": "boolean",
            "description": "Read from the end (useful for error logs)."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "integer",
                  "description": "Stable document id (survives index rebuilds)."
                },
                "ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "session": {
                  "type": "string",
                  "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
                },
                "agent": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer",
                  "description": "Byte offset of content within the document."
                },
                "total_bytes": {
                  "type": "integer"
                },
                "content": {
                  "type": "string"
                },
                "next_offset": {
                  "type": "integer",
                  "description": "Byte offset to pass as offset for the rest of this document."
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "doc_id"
              ]
            }
          },
          "remaining_doc_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "doc_ids not read because the batch budget ran out."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Notes and hints that also appear in the text result."
          }
        },
        "required": [
          "documents"
        ]
      }
    },
    {
      "name": "list_sessions",
      "description": "List local Codex, AGY, Pi, and Factory Droid sessions sorted by most recent activity, with first/last activity times, short unique @ids, and auto-extracted titles.",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent": { "type": "string", "description": "Comma-separated filter: codex, agy, pi, droid." },
          "project": { "type": "string", "description": "Substring match against project/cwd path." },
          "since": { "type": "string", "description": "Only sessions active at or after this time: 7d, 24h, today, YYYY-MM-DD, or ISO-8601." },
          "until": { "type": "string", "description": "Only sessions active at or before this time (inclusive), same formats as since." },
          "limit": { "type": "integer", "description": "Max sessions (default 20)." },
          "offset": { "type": "integer", "description": "Pagination offset." }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session": {
                  "type": "string",
                  "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
                },
                "session_id": {
                  "type": "string"
                },
                "agent": {
                  "type": "string"
                },
                "first_ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
