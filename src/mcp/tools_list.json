{
  "tools": [
    {
      "name": "search_history",
      "description": "Search local coding agent history (Codex CLI, AGY CLI, Pi, Factory Droid) to pinpoint when and who made a decision. BEST FIRST STEP: call with group_by='session' (e.g. query='中文 | english', group_by='session') to locate the right session(s) cleanly, then call get_session_digest. Default searches human prompts, assistant replies, inter-agent messages, and tool calls (excluding noisy tool outputs & injected prompts).",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Keywords, `A | B` or `A OR B` (uppercase OR only), `-term`/`-\"phrase\"` negation, `prefix*` wildcard, quoted phrases, or inline filters (`agent:agy role:user project:foo since:7d @sid8`)."
          },
          "case": {
            "type": "string",
            "description": "Case matching: smart (default: case-sensitive if query has uppercase), insensitive, or sensitive."
          },
          "fixed": {
            "type": "boolean",
            "description": "Literal fixed-string substring match (-F), disabling query syntax parsing."
          },
          "regex": {
            "type": "boolean",
            "description": "PCRE2 JIT regular expression match (-E) with automatic literal/index prefiltering."
          },
          "agent": {
            "type": "string",
            "description": "Comma-separated filter: codex, agy, pi, droid."
          },
          "project": {
            "type": "string",
            "description": "Substring match against project/cwd path."
          },
          "role": {
            "type": "string",
            "description": "Comma-separated filter: user, assistant, inter_agent, tool_call, tool_result, thinking, system."
          },
          "exclude_role": {
            "type": "string",
            "description": "Comma-separated roles to exclude."
          },
          "actor": {
            "type": "string",
            "description": "Substring match against actor/model name."
          },
          "session": {
            "type": "string",
            "description": "Exact session id or short @prefix."
          },
          "since": {
            "type": "string",
            "description": "Start time (inclusive): relative (30m, 24h, 7d, 2w), today, yesterday, YYYY-MM-DD, or YYYY-MM-DDTHH:MM[:SS][Z|+HH:MM]. Local time unless a zone is given."
          },
          "until": {
            "type": "string",
            "description": "End time (inclusive, same formats as since). A date-only value covers that whole day."
          },
          "sort": {
            "type": "string",
            "description": "relevance (default), oldest, or newest."
          },
          "group_by": {
            "type": "string",
            "description": "Set to 'session' to group hits by session with agent, date, title, hit count, and best snippet (ideal first step before get_session_digest)."
          },
          "count_by": {
            "type": "string",
            "description": "Return grouped counts by: agent, role, project, actor, session."
          },
          "no_subagents": {
            "type": "boolean",
            "description": "Exclude subagent transcripts."
          },
          "no_dedup": {
            "type": "boolean",
            "description": "Disable exact-duplicate folding across forked/retried transcripts."
          },
          "include_tools": {
            "type": "boolean",
            "description": "Include tool_result records (only effective when the index was built with --include-tools)."
          },
          "include_thinking": {
            "type": "boolean",
            "description": "Include model thinking/reasoning summaries (only effective when the index was built with --include-thinking)."
          },
          "limit": {
            "type": "integer",
            "description": "Max hits or session groups (default 15)."
          },
          "offset": {
            "type": "integer",
            "description": "Pagination offset."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "hits",
              "sessions",
              "counts"
            ],
            "description": "hits (default), sessions (group_by=session), or counts (count_by)."
          },
          "total_matches": {
            "type": "integer"
          },
          "shown": {
            "type": "integer"
          },
          "elapsed_ms": {
            "type": "number"
          },
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "integer",
                  "description": "Stable document id (survives index rebuilds)."
                },
                "ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "session": {
                  "type": "string",
                  "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
                },
                "agent": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                }
              },
              "required": [
                "doc_id",
                "ts",
                "session",
                "role",
                "snippet"
              ]
            }
          },
          "total_sessions": {
            "type": "integer"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session": {
                  "type": "string",
                  "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
                },
                "agent": {
                  "type": "string"
                },
                "last_hit_ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "hit_count": {
                  "type": "integer"
                },
                "project": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "best_doc_id": {
                  "type": "integer",
                  "description": "Stable document id (survives index rebuilds)."
                },
                "best_snippet": {
                  "type": "string"
                }
              },
              "required": [
                "session",
                "hit_count",
                "best_doc_id"
              ]
            }
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Bucket key; @session id when count_by=session."
                },
                "count": {
                  "type": "integer"
                },
                "agent": {
                  "type": "string"
                },
                "last_ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "count"
              ]
            }
          },
          "next_offset": {
            "type": "integer",
            "description": "Pass as offset to fetch the next page; absent on the last page."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Notes and hints that also appear in the text result."
          }
        },
        "required": [
          "mode",
          "total_matches"
        ]
      }
    },
    {
      "name": "get_session_digest",
      "description": "Return the condensed chronological user<->assistant decision stream of a single session (by @prefix or full session_id). Collapses intermediate tool calls into counts, skips duplicate retries, and keeps ending options/conclusions intact within an inline-friendly byte budget. Long sessions show the opening and closing turns with the omitted middle range marked; page through it with offset. Ambiguous prefixes return the matching candidates.",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "description": "Session UUID or short @prefix (e.g. @30c3cab1)."
          },
          "offset": {
            "type": "integer",
            "description": "First dialogue turn (#n) to show, e.g. the offset suggested by an omitted-turns marker (default 0 = head + tail overview)."
          },
          "max_bytes": {
            "type": "integer",
            "description": "Optional text budget in bytes (default 7200). Omit this parameter to keep output inline; values >8000 may spill to disk and require an extra read turn."
          },
          "include_tools": {
            "type": "boolean",
            "description": "Include tool_call records instead of collapsing them."
          }
        },
        "required": ["session"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "description": "Short unique session id (e.g. @98e6e4c2) accepted by session arguments."
          },
          "session_id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "first_ts": {
            "type": "string",
            "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
          },
          "last_ts": {
            "type": "string",
            "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
          },
          "project": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "total_turns": {
            "type": "integer"
          },
          "tools_collapsed": {
            "type": "integer"
          },
          "duplicates_skipped": {
            "type": "integer"
          },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "turn": {
                  "type": "integer",
                  "description": "Dialogue turn number (#n), usable as offset."
                },
                "doc_id": {
                  "type": "integer",
                  "description": "Stable document id (survives index rebuilds)."
                },
                "ts": {
                  "type": "string",
                  "description": "Local time with UTC offset, e.g. 2026-11-19T21:22:11+08:00; accepted by since/until."
                },
                "role": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "description": "Turn text, trimmed when trimmed=true (read it in full with get_document)."
                },
                "trimmed": {
                  "type": "boolean"
                },
                "tools_before": {
                  "type": "integer",
                  "description": "Tool records collapsed before this turn."
                }
              },
              "required": [
                "turn",
                "doc_id",
                "ts",
                "role",
                "text"
              ]
            }
          },
          "omitted": {
            "type": "object",
            "properties": {
              "from_turn": {
                "type": "integer"
              },
              "to_turn": {
                "type": "integer"
              },
              "next_offset": {
                "type": "integer"
              }
            },
            "required": [
              "from_turn",
              "to_turn",
              "next_offset"
            ]
          },
          "next_offset": {
            "type": "integer",
            "description": "Pass as offset to fetch the next page; absent on the last page."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Notes and hints that also appear in the text result."
          }
        },
        "required": [
          "session",
          "session_id",
          "total_turns",
          "turns"
        ]
      }
    },
    {
      "name": "get_decision_timeline",
      "description": "Return chronological (oldest-first) hits across MULTIPLE sessions for a topic. Do NOT call this in parallel with search_history(group_by='session'); prefer search_history(group_by='session') -> get_session_digest when investigating a feature or single-session decision.",
      "annotations": { "readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
