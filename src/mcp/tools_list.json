          "since": { "type": "string", "description": "Start time: 7d, 24h, today, YYYY-MM-DD, or ISO-8601 (local time unless zoned)." },
          "until": { "type": "string", "description": "End time (inclusive), same formats as since." },
          "no_subagents": { "type": "boolean", "description": "Exclude subagent transcripts." },
          "limit": { "type": "integer", "description": "Max hits (default 10)." },
          "offset": { "type": "integer", "description": "Pagination offset." }
